@CompanyPortal.Api_HostAddress = http://localhost:5042
# The auth cookie is Secure, so auth requests must use https (run with: dotnet run --launch-profile https)
@CompanyPortal.Api_HttpsAddress = https://localhost:7073

GET {{CompanyPortal.Api_HostAddress}}/api/health
Accept: application/json

###

# 1. Not logged in yet - expect 401 Unauthorized
GET {{CompanyPortal.Api_HttpsAddress}}/api/auth/me
Accept: application/json

###

# 2. Wrong password - expect 401 with "Invalid email or password."
POST {{CompanyPortal.Api_HttpsAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@company.test",
  "password": "wrong-password"
}

###

# 3. Correct login - expect 200 and a Set-Cookie header (the cookie is stored for the next requests)
POST {{CompanyPortal.Api_HttpsAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@company.test",
  "password": "Demo1234!"
}

###

# 4. Protected endpoint - expect 200 with your user details (only works after step 3)
GET {{CompanyPortal.Api_HttpsAddress}}/api/auth/me
Accept: application/json

###

# --- Employees (all require login, so run step 3 first) ---

# 5. List all employees - expect 200 with an array
GET {{CompanyPortal.Api_HttpsAddress}}/api/employees
Accept: application/json

###

# 6. Create an employee - expect 201 with the new employee and a Location header
# @name createEmployee
POST {{CompanyPortal.Api_HttpsAddress}}/api/employees
Content-Type: application/json

{
  "name": "Anna Svensson",
  "department": "IT",
  "role": "Developer",
  "email": "anna@company.test"
}

###

# 7. Create the same email again - expect 409 Conflict (run step 6 first)
POST {{CompanyPortal.Api_HttpsAddress}}/api/employees
Content-Type: application/json

{
  "name": "Anna Andersson",
  "department": "HR",
  "role": "Recruiter",
  "email": "anna@company.test"
}

###

# 8. Invalid data - expect 400 Bad Request with validation errors
POST {{CompanyPortal.Api_HttpsAddress}}/api/employees
Content-Type: application/json

{
  "name": "",
  "department": "IT",
  "role": "Developer",
  "email": "not-an-email"
}

###

# 9. Get one employee - expect 200 (uses the id from step 6)
GET {{CompanyPortal.Api_HttpsAddress}}/api/employees/{{createEmployee.response.body.id}}
Accept: application/json

###

# 10. Update the employee - expect 200 with the changed values (uses the id from step 6)
PUT {{CompanyPortal.Api_HttpsAddress}}/api/employees/{{createEmployee.response.body.id}}
Content-Type: application/json

{
  "name": "Anna Svensson",
  "department": "IT",
  "role": "Tech Lead",
  "email": "anna@company.test"
}

###

# 11. Delete the employee - expect 204 No Content (uses the id from step 6)
DELETE {{CompanyPortal.Api_HttpsAddress}}/api/employees/{{createEmployee.response.body.id}}
Accept: application/json

###

# 12. Get the deleted employee - expect 404 Not Found
GET {{CompanyPortal.Api_HttpsAddress}}/api/employees/{{createEmployee.response.body.id}}
Accept: application/json

###

# 13. Log out - expect 204 No Content
POST {{CompanyPortal.Api_HttpsAddress}}/api/auth/logout

###
